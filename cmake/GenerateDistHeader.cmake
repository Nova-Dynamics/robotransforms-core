get_filename_component(OUTPUT_DIR "${OUTPUT_VERSIONED_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

if (EXISTS "${OUTPUT_VERSIONED_HEADER}" AND IS_DIRECTORY "${OUTPUT_VERSIONED_HEADER}")
	file(REMOVE_RECURSE "${OUTPUT_VERSIONED_HEADER}")
endif()

if (EXISTS "${OUTPUT_LATEST_HEADER}" AND IS_DIRECTORY "${OUTPUT_LATEST_HEADER}")
	file(REMOVE_RECURSE "${OUTPUT_LATEST_HEADER}")
endif()

file(READ "${INPUT_VERSION_HEADER}" VERSION_HEADER_CONTENT)
file(READ "${INPUT_EUCLIDEAN_HEADER}" EUCLIDEAN_HEADER_CONTENT)

set(DIST_HEADER_CONTENT
"#pragma once

// robotransforms-core single-header distribution
// Generated by CMake from robotransforms/version.hpp and robotransforms/euclidean.hpp.
// Version: ${PROJECT_VERSION}

${VERSION_HEADER_CONTENT}

${EUCLIDEAN_HEADER_CONTENT}
")

file(WRITE "${OUTPUT_VERSIONED_HEADER}" "${DIST_HEADER_CONTENT}")
file(WRITE "${OUTPUT_LATEST_HEADER}" "${DIST_HEADER_CONTENT}")